<script>
    async function toggleUser(userId, flagValue) {
        console.log("flagvalue", flagValue);
        console.log("userId" . userId)
        let msg = flagValue ? "active" : "inactive";
        let toastBGC = flagValue ? "linear-gradient(to right, #3aab30, #00FF11)" : "linear-gradient(to right, #FF0000, #FF0055)";
 
        try {
            const response = await fetch('/member/update-memberstatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ statusToggleChange: msg, userId: userId })
            });

            const data = await response.json();
            console.log(data);

            Toastify({
                text: `Status changed to ${msg}`,
                duration: 3000,
                close: true,
                gravity: "top",
                position: "right",
                stopOnFocus: false,
                backgroundColor : toastBGC
            }).showToast();

        } catch (error) {
            console.log('Error:', error);
        }
    }
</script>
